# File storage is the no-setup default. Set STORAGE_MODE=postgres to use PostGIS.
STORAGE_MODE=file
DATA_FILE=../../data/heatmap.json
# URL for your locally installed PostgreSQL server. Replace YOUR_PASSWORD when using postgres mode.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/heatmap
POSTGRES_DB=heatmap
POSTGRES_USER=heatmap
POSTGRES_PASSWORD=heatmap
POSTGRES_PORT=5432
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://localhost:4200
